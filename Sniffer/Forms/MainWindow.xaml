<Window x:Class="Sniffer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sniffer Network Analyzer" Icon="/Images/icon.ico"
        MinHeight="500" MinWidth="750" Width="1200" Height="750"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open capture..." Click="btnOpen_Click"/>
                <MenuItem Header="_Save capture..." Click="btnSave_Click"/>
                <Separator/>
                <MenuItem Header="_Back" Click="btnBack_Click"/>
                <MenuItem Header="E_xit" Click="btnExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Click="btnDoc_Click"/>
                <MenuItem Header="_About" Click="btnAbout_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <ToolBar.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Height" Value="18"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToolBar.Resources>
            <Button x:Name="btnStart" ToolTip="Start capturing" AutomationProperties.Name="Start capturing" Click="btnStart_Click">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/play.png"/><TextBlock Text="Start" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="btnStop" ToolTip="Stop capturing" AutomationProperties.Name="Stop capturing" Click="btnStop_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/stop.png"/><TextBlock Text="Stop" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="btnRestart" ToolTip="Restart capture" AutomationProperties.Name="Restart capture" Click="btnRestart_Click">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/restart.png"/><TextBlock Text="Restart" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button ToolTip="Back to welcome screen" AutomationProperties.Name="Back to welcome screen" Click="btnClose_Click">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/left.png"/><TextBlock Text="Back" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="First packet" AutomationProperties.Name="First packet" Click="btnGoToFirst_Click"><Image Source="/Images/first.png"/></Button>
            <Button ToolTip="Previous packet" AutomationProperties.Name="Previous packet" Click="btnPreviousPacket_Click"><Image Source="/Images/left.png"/></Button>
            <Button ToolTip="Next packet" AutomationProperties.Name="Next packet" Click="btnNextPacket_Click"><Image Source="/Images/right.png"/></Button>
            <Button ToolTip="Last packet" AutomationProperties.Name="Last packet" Click="btnGoToEnd_Click"><Image Source="/Images/end.png"/></Button>
            <TextBox x:Name="tbxGoTo" Width="55" ToolTip="Displayed packet number" TextAlignment="Center"/>
            <Button ToolTip="Go to displayed packet" AutomationProperties.Name="Go to displayed packet" Click="btnGoTo_Click">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/goto.png"/><TextBlock Text="Go" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <ToggleButton ToolTip="Automatically scroll to the latest packet" AutomationProperties.Name="Auto-scroll" Click="btnAutoScroll_Click">
                <StackPanel Orientation="Horizontal"><Image Source="/Images/scroll.png"/><TextBlock Text="Auto-scroll" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </ToggleButton>
        </ToolBar>
        <DockPanel DockPanel.Dock="Top" Margin="6,3">
            <TextBlock Text="Display filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="tbxFindWhat" MinWidth="300" TextChanged="tbxFindWhat_TextChanged"
                     ToolTip="Examples: tcp, ip.addr == 192.0.2.1, tcp.port == 443 &amp;&amp; ip"/>
            <TextBlock x:Name="filterError" Foreground="DarkRed" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="Adapter: "/><TextBlock x:Name="tbxAdapter" Margin="0,0,12,0"/>
            <TextBlock Text="Captured: "/><TextBlock x:Name="tbxTotalPackets" Text="0" Margin="0,0,12,0"/>
            <TextBlock Text="Displayed: "/><TextBlock x:Name="tbxTotalDisPackets" Text="0" Margin="0,0,12,0"/>
            <TextBlock Text="Computer: "/><TextBlock x:Name="tbxComputerName"/>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="dgPackets" Grid.Row="0" AutoGenerateColumns="False" SelectionMode="Single"
                      CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True"
                      SelectionChanged="dgPackets_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Protocol}" Value="TCP"><Setter Property="Background" Value="#E8F0FF"/></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="UDP"><Setter Property="Background" Value="#E8F8FF"/></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="DNS"><Setter Property="Background" Value="#E8E4FF"/></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="HTTP"><Setter Property="Background" Value="#DDF5DD"/></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="ARP"><Setter Property="Background" Value="#FFF2CC"/></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="ICMP"><Setter Property="Background" Value="#FCE4E4"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding ID}" Width="60"/>
                    <DataGridTextColumn Header="Time (s)" Binding="{Binding Time, StringFormat=F6}" Width="100"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="160"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="85"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="70"/>
                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
            <TreeView x:Name="tvDetails" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"/>
            <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="PacketBytesTextBoxStyle" TargetType="TextBox">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="SelectionBrush" Value="#F6B84A"/>
                            <Setter Property="SelectionOpacity" Value="0.8"/>
                            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Hexadecimal" FontWeight="SemiBold" Margin="0,2,16,4"/>
                    <TextBlock Grid.Column="1" Text="ASCII (non-printable bytes: .)" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <TextBox x:Name="tbxBuffer" Grid.Row="1" Margin="0,0,16,0"
                             Style="{StaticResource PacketBytesTextBoxStyle}"
                             ToolTip="Click a hexadecimal byte to highlight its ASCII character"
                             SelectionChanged="HexBytes_SelectionChanged"
                             PreviewMouseLeftButtonDown="HexBytes_MouseLeftButtonDown"/>
                    <TextBlock x:Name="tbxDecode" Grid.Row="1" Grid.Column="1"
                               FontFamily="Consolas" TextWrapping="NoWrap"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
